# Copy thành .env (root) và packages/db/.env
# Postgres docker map ra 5433 (host có sẵn Postgres ở 5432)
DATABASE_URL="postgresql://bta:bta@localhost:5433/bta?schema=public"

# API
PORT=2001
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# S3/MinIO (dev)
S3_ENDPOINT=http://localhost:9400
S3_ACCESS_KEY=bta
S3_SECRET_KEY=bta-secret
S3_BUCKET=bta-dev

# Chỉ dùng test cục bộ: bật cho phép token "dev:<email>" bỏ qua verify Firebase. TUYỆT ĐỐI không bật ở production.
# DEV_AUTH_BYPASS=1
