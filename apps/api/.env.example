PORT=2001
DATABASE_URL="postgresql://bta:bta@localhost:5432/bta?schema=public"
# Test DB dùng cho vitest e2e
TEST_DATABASE_URL="postgresql://bta:bta@localhost:5432/bta_test?schema=public"
# Cho phép Authorization: Bearer dev:<email> (CHỈ dev/test)
AUTH_DEV_BYPASS=true
FIREBASE_PROJECT_ID=bac-tai-app
DRIVER_JWT_SECRET=change-me-driver
CUSTOMER_JWT_SECRET=change-me-customer
STORAGE_SIGNING_SECRET=change-me-storage
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# URL public của API (dùng ký link upload/download local)
API_PUBLIC_URL=http://localhost:2001
# S3 (khi STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Cho phép tạo merchant self-service
ALLOW_SELF_SERVICE_MERCHANT=true
# Job định kỳ (cảnh báo COD/quá hạn, dọn GPS) — tắt bằng false
SCHEDULER_ENABLED=true
# Đường dẫn Chromium cho xuất PDF (để trống: tự dò trong cache Playwright)
CHROMIUM_PATH=
# App Merchant đăng nhập SĐT + mật khẩu (D-014)
USER_JWT_SECRET=change-me-user
# OTP Web Khách hàng (D-013b): SMS_DRIVER=log (dev in mã ra log) | sns (AWS SNS)
OTP_SECRET=change-me-otp
SMS_DRIVER=log
AWS_REGION=ap-southeast-1
SNS_SENDER_ID=
