{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "types": ["vite/client", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@bta/shared": ["../../packages/shared/src/index.ts"],
      "@bta/shadcn": ["../../packages/shadcn/src/index.ts"],
      "@bta/shadcn/*": ["../../packages/shadcn/src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "codegen.ts", "tailwind.config.cjs"]
}
