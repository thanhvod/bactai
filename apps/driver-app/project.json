{
  "name": "driver-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "run": {
      "executor": "nx:run-commands",
      "options": { "command": "flutter run", "cwd": "apps/driver-app" }
    },
    "analyze": {
      "executor": "nx:run-commands",
      "options": { "command": "flutter analyze", "cwd": "apps/driver-app" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "flutter test", "cwd": "apps/driver-app" }
    }
  }
}
