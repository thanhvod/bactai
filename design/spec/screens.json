[
  {
    "id": "WM-ORD-01",
    "name": "Danh sách đơn hàng",
    "platform": "wm",
    "platformName": "Web Merchant",
    "phase": 1,
    "module": "Đơn hàng",
    "route": "/orders",
    "pattern": "list",
    "purpose": "Tìm/lọc đơn, theo dõi trạng thái và tiền; điểm vào tạo đơn và chi tiết đơn.",
    "roles": [
      "admin",
      "operation",
      "accountant"
    ],
    "api": [
      "orders(filter, sort, first, after)"
    ],
    "data": [
      "code",
      "customer.name",
      "routeSummary",
      "status",
      "totalAmount",
      "paidAmount",
      "remainingAmount",
      "dueDate",
      "warnings[]"
    ],
    "actions": [
      {
        "label": "Tạo đơn",
        "guard": "order.create"
      },
      {
        "label": "Xuất Excel",
        "guard": "order.view"
      },
      {
        "label": "Bulk: in phiếu / xuất",
        "guard": "order.view"
      }
    ],
    "states": {
      "loading": "DataTable loading (skeleton rows)",
      "empty": "EmptyState 'Chưa có đơn hàng' + nút 'Tạo đơn đầu tiên'",
      "error": "Banner danger 'Không tải được danh sách đơn' + Thử lại"
    },
    "notes": [
      "Quick filter chips map sang filter.status/warning; filter nâng cao mở Drawer.",
      "Cột tiền căn phải, tabular-nums.",
      "Row click hoặc click mã → /orders/:orderId."
    ],
    "overlayOf": null,
    "components": [
      "StatusBadge",
      "Menu",
      "IconButton",
      "Button",
      "PageHeader",
      "FilterBar",
      "TextField",
      "FilterChip",
      "Pagination",
      "DataTable",
      "Checkbox",
      "AppShell",
      "Sidebar",
      "Logo",
      "Topbar",
      "QuickSearch",
      "NotificationBell"
    ],
    "size": {
      "w": 1440,
      "h": 960
    },
    "mockup": "design/mockups/WM-ORD-01.html",
    "spec": "design/screens/wm/WM-ORD-01.md"
  },
  {
    "id": "WM-ORD-02",
    "name": "Chi tiết đơn hàng",
    "platform": "wm",
    "platformName": "Web Merchant",
    "phase": 1,
    "module": "Đơn hàng",
    "route": "/orders/:orderId",
    "pattern": "detail",
    "purpose": "Trung tâm xử lý một đơn: trạng thái, tiền, điểm dừng, chuyến, sự cố, chứng từ, timeline.",
    "roles": [
      "admin",
      "operation",
      "accountant"
    ],
    "api": [
      "order(id)",
      "activityLogs(entityType: ORDER, entityId)"
    ],
    "data": [
      "code",
      "status",
      "customer",
      "stops[]",
      "cargoLines[]",
      "addons[]",
      "trips[]",
      "financeSummary",
      "incidents[]",
      "attachments[]"
    ],
    "actions": [
      {
        "label": "Tạo chuyến",
        "guard": "trip.create"
      },
      {
        "label": "Sửa",
        "guard": "order.update"
      },
      {
        "label": "In phiếu",
        "guard": "order.view"
      },
      {
        "label": "Hủy đơn",
        "guard": "order.cancel — sensitive"
      },
      {
        "label": "Timeline",
        "guard": "order.view"
      }
    ],
    "states": {
      "loading": "Skeleton header + tabs",
      "error": "Không tìm thấy đơn / không có quyền → EmptyState + quay lại danh sách"
    },
    "notes": [
      "Tabs dùng ?tab= (overview|stops|cargo|trips|finance|incidents|attachments|timeline).",
      "Primary next action đổi theo trạng thái: Nháp→Xác nhận; Đã xác nhận→Tạo chuyến; Hoàn thành→Ghi nhận thanh toán."
    ],
    "overlayOf": null,
    "components": [
      "StatusBadge",
      "DataTable",
      "DescriptionList",
      "PartnerCard",
      "Timeline",
      "EntityHeader",
      "Button",
      "IconButton",
      "SummaryStrip",
      "Breadcrumb",
      "Tabs",
      "AppShell",
      "Sidebar",
      "Logo",
      "Topbar",
      "QuickSearch",
      "NotificationBell"
    ],
    "size": {
      "w": 1440,
      "h": 1140
    },
    "mockup": "design/mockups/WM-ORD-02.html",
    "spec": "design/screens/wm/WM-ORD-02.md"
