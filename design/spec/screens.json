      "admin",
      "operation",
      "accountant"
    ],
    "api": [
      "customers",
      "customerLocations(customerId)",
      "catalogItems(type: ADDON|CARGO_TYPE)",
      "createOrder(input)",
      "updateOrder(id, input)"
