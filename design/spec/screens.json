[
  {
    "id": "WM-CUS-01",
    "name": "Danh sách khách hàng",
    "platform": "wm",
    "platformName": "Web Merchant",
    "phase": 1,
    "module": "Khách hàng",
    "route": "/customers",
    "pattern": "list",
    "purpose": "Tìm/lọc khách, theo dõi công nợ, số dư, hạn mức và cảnh báo; điểm vào tạo khách, import, tạo đơn nhanh.",
    "roles": [
      "admin",
      "operation",
      "accountant"
    ],
    "api": [
      "customers(filter, sort, first, after)"
    ],
    "data": [
      "code",
      "name",
      "phone",
      "taxCode",
      "debtSummary{remaining, overdue, overdueDays}",
      "creditBalance",
      "creditLimit",
      "limitUsagePct",
      "defaultDebtDays",
      "orderCount",
      "warnings[]",
      "isActive"
    ],
    "actions": [
      {
        "label": "Tạo khách hàng",
        "guard": "customer.create (admin/operation/accountant)"
      },
      {
        "label": "Import",
        "guard": "customer.create → WM-SHELL-04"
      },
      {
        "label": "Xuất Excel",
        "guard": "customer.view"
      },
      {
        "label": "Row menu: Tạo đơn",
        "guard": "order.create → WM-ORD-03 prefill customerId"
      },
      {
        "label": "Row menu: Ghi nhận thanh toán",
        "guard": "payment.create"
      },
      {
        "label": "Row menu: Ngừng hoạt động",
        "guard": "customer.deactivate — sensitive nếu có đơn (admin; operation nếu được cấp)"
      }
    ],
    "states": {
      "loading": "DataTable skeleton rows",
      "empty": "EmptyState 'Chưa có khách hàng' + Tạo khách hàng / Import từ Excel",
      "error": "Banner danger 'Không tải được danh sách khách' + Thử lại",
      "filtered-empty": "Không có khách khớp bộ lọc + Xóa bộ lọc"
    },
    "notes": [
      "Search theo tên/SĐT/MST/mã; chip lọc: còn nợ, quá hạn, vượt hạn mức, có số dư, ngừng hoạt động.",
      "Cột hạn mức: số hạn mức + thanh % đã dùng (≥80% warning, >100% danger). Vượt hạn mức chỉ cảnh báo, không chặn tạo đơn.",
      "Khách ngừng hoạt động hiển thị mờ, không chọn được khi tạo đơn mới.",
      "KPI Tổng còn nợ/Quá hạn mở WM-DEBT-01."
    ],
    "overlayOf": null,
    "components": [
      "StatusBadge",
      "IconButton",
      "Button",
      "Menu",
      "Popover",
      "KpiCard",
      "PageHeader",
      "FilterBar",
      "TextField",
      "FilterChip",
      "Pagination",
      "DataTable",
      "AppShell",
      "Sidebar",
      "Logo",
      "Topbar",
      "QuickSearch",
      "NotificationBell"
