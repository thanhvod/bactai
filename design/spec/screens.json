[
  {
    "id": "WM-TRIP-01",
    "name": "Chi tiết chuyến",
    "platform": "wm",
    "platformName": "Web Merchant",
    "phase": 1,
    "module": "Điều phối",
    "route": "/trips/:tripId",
    "pattern": "detail",
    "purpose": "Trung tâm một chuyến: phân công xe/tài xế, điểm dừng được giao, trạng thái (cập nhật thay tài xế), chi phí, thưởng, POD/COD, GPS, sự cố, timeline.",
    "roles": [
      "admin",
      "operation",
      "accountant"
    ],
    "api": [
      "trip(id)",
      "updateTripStatus(id, status, reason?)",
      "updateTrip(id, input, reason?)",
      "activityLogs(entityType: TRIP, entityId)",
      "tripLocations(tripId, last: 1)"
    ],
    "data": [
      "code",
      "status",
      "order{code, customer}",
      "vehicle{plate, type}",
      "driver{name, phone}",
      "plannedStartAt",
      "plannedEndAt",
      "actualStartAt",
      "stops[{sequence, type, location, contact, codExpected, codActual, podCount, status, actualArrivedAt, actualCompletedAt}]",
      "expenses[]",
      "advances[]",
      "driverBonusAmount",
      "lastLocation{lat, lng, capturedAt, speed}",
      "incidents[]"
    ],
    "actions": [
      {
        "label": "Cập nhật trạng thái thay tài xế",
        "guard": "trip.status.update (Admin, Operation)"
      },
      {
        "label": "Tạm dừng / hủy / đổi ngược",
        "guard": "trip.status.update — sensitive, lý do bắt buộc"
      },
      {
        "label": "Sửa chuyến / đổi xe, tài xế",
        "guard": "trip.assign → WM-TRIP-02, check overlap"
      },
      {
        "label": "Thêm chi phí",
        "guard": "expense.create → WM-EXP-03"
      },
      {
        "label": "Báo sự cố",
        "guard": "incident.manage"
      },
      {
        "label": "In phiếu điều xe",
        "guard": "trip.view"
      }
    ],
    "states": {
      "loading": "Skeleton header + tabs",
      "error": "Không tìm thấy chuyến / không có quyền → EmptyState + quay lại bảng điều phối",
      "offline driver": "Banner info 'App tài xế mất kết nối từ 10:50' khi lastSeen > 15 phút"
    },
    "notes": [
      "Tabs dùng ?tab= (overview|stops|expenses|podcod|gps|incidents|timeline); mockup vẽ tab Tổng quan gồm tóm tắt mọi tab.",
      "Tạm dừng lưu previous status để resume. Hủy chuyến/đổi ngược mở SensitiveActionModal (WM-SHELL-08).",
      "Tạm ứng chuyến không tính vào lãi/lỗ đến khi đối soát (WM-ADV-01). COD tài xế thu không phải doanh thu.",
      "Accountant chỉ xem; nút cập nhật trạng thái/sửa ẩn theo quyền."
    ],
    "overlayOf": null,
    "components": [
      "StatusBadge",
      "DataTable",
      "Button",
      "DescriptionList",
      "StatusStepper",
      "Stepper",
      "MapView",
      "Timeline",
      "EntityHeader",
      "IconButton",
      "SummaryStrip",
      "Breadcrumb",
      "Tabs",
      "AppShell",
      "Sidebar",
      "Logo",
      "Topbar",
      "QuickSearch",
      "NotificationBell"
    ],
    "size": {
      "w": 1440,
      "h": 1440
    },
    "mockup": "design/mockups/WM-TRIP-01.html",
    "spec": "design/screens/wm/WM-TRIP-01.md"
