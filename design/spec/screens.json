    "platformName": "Web Merchant",
    "phase": 1,
    "module": "Đơn hàng",
    "route": "/orders/new · /orders/:orderId/edit",
    "pattern": "form",
    "purpose": "Tạo đơn nhanh 1 xe (không wizard): khách → điểm lấy/trả → hàng → giá cước/add-on → hạn thanh toán.",
