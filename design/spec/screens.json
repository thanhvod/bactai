        "label": "Tạo đơn",
        "guard": "order.create"
      },
      {
        "label": "Ghi nhận thanh toán",
        "guard": "payment.create (admin/accountant; operation ⚠️)"
      },
      {
        "label": "Sửa",
        "guard": "customer.update"
      },
      {
        "label": "Tạo bảng kê",
        "guard": "debtStatement.create (admin/accountant)"
