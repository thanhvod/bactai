    "data": [
      "name",
      "legalName",
      "type",
      "taxCode",
      "phone",
      "invoiceEmail",
      "primaryContact",
      "billingAddress",
      "creditLimit",
      "defaultDebtDays",
      "debtSummary",
      "creditBalance",
      "recentOrders[]",
