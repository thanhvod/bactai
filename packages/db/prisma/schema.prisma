// BTA — Prisma schema (PostgreSQL). Nguồn: doc/1-BRD/07-data-model.md, doc/3-TECHNICAL/ARCHITECTURE.md §12–13.
// Quy ước: mọi bảng nghiệp vụ có merchantId; tiền VND = BigInt; không xóa cứng (status/cancel/deletedAt);
// enum khớp @bta/shared (packages/db/src/enum-sync.spec.ts kiểm tra).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS (khớp packages/shared/src/status.ts & permissions.ts)
// ============================================================================

enum MerchantRole {
  ADMIN
  OPERATION
  ACCOUNTANT
}

enum PermissionGrant {
  ALLOWED
  GRANTABLE
  DENIED
}

enum MemberStatus {
  INVITED
  ACTIVE
  LOCKED
}

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum CustomerType {
  COMPANY
  INDIVIDUAL
}

enum LocationUsage {
  PICKUP
  DROPOFF
  BOTH
  DOCUMENTS
}

enum DriverAccountStatus {
  NONE
  ACTIVE
  MUST_CHANGE_PASSWORD
  DISABLED
}

enum CatalogType {
  EXPENSE_CATEGORY
  ADDON_SERVICE
  CARGO_TYPE
  PACKAGING_UNIT
  PAUSE_REASON
  DEDUCTION_REASON
  DOCUMENT_TYPE
  INCIDENT_TYPE
  VEHICLE_TYPE
  SUPPLIER_TYPE
  CUSTOMER_GROUP
}

enum OrderStatus {
  DRAFT
  PENDING_CONFIRMATION
  CONFIRMED
  DISPATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TripStatus {
  SCHEDULED
  TO_PICKUP
  PICKING_UP
  IN_TRANSIT
  PAUSED
  DELIVERING
  COMPLETED
  CANCELLED
}

enum StopStatus {
  NOT_ARRIVED
  ARRIVED
  COMPLETED
  SKIPPED
}

enum StopType {
  PICKUP
  DROPOFF
}

enum CargoProperty {
  FRAGILE
  COLD
  OVERSIZE
  HAZARDOUS
}

enum ScheduleWarningType {
  OVERLAP
  NEAR_OVERLAP
}

enum ScheduleSubject {
  VEHICLE
  DRIVER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum ExpenseKind {
  TRIP_COST
  EXTERNAL_TRANSPORT
  VEHICLE_SUPPLY
  OTHER_COST
  DRIVER_REIMBURSEMENT
  SALARY_ADVANCE
  TRIP_ADVANCE
  SALARY_PAYMENT
}

enum ExpensePaidBy {
  COMPANY
  DRIVER
  DRIVER_ADVANCE
}

enum PaidStatus {
  UNPAID
  PAID
}

enum DocStatus {
  ACTIVE
  CANCELLED
}

enum PaymentInType {
  CUSTOMER_PAYMENT
  DRIVER_COD_REMITTANCE
  DRIVER_ADVANCE_RETURN
  OTHER
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  OTHER
}

enum TripAdvanceStatus {
