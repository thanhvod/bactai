// BTA — Prisma schema phase 1
// Nguồn thiết kế: docs/07-data-model.md (đọc kèm docs/02→05 để hiểu nghiệp vụ)
// Quy ước:
// - Tiền VND lưu BigInt (đồng, số nguyên). API chịu trách nhiệm serialize BigInt -> number.
// - Mọi aggregate nghiệp vụ có merchantId (multi-tenant); bảng con đi theo cha.
// - Không xóa cứng: dùng isActive / trạng thái CANCELLED.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== Enums =====

enum UserRole {
  ADMIN // giám đốc — có quyền duyệt bảng lương
  OPERATION
  ACCOUNTANT
}

// docs/02 mục 4.1
enum OrderStatus {
  DRAFT
  PENDING_CONFIRM
  CONFIRMED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// docs/02 mục 4.2 — PAUSED kèm pauseReason (danh mục PAUSE_REASON)
enum TripStatus {
  SCHEDULED
  TO_PICKUP
  PICKING_UP
  IN_TRANSIT
  PAUSED
  DELIVERING
  COMPLETED
  CANCELLED
}

enum StopType {
  PICKUP
  DROPOFF
}

// docs/02 mục 4.3
enum StopStatus {
  PENDING
  ARRIVED
  COMPLETED
  SKIPPED
}

// Một bảng danh mục dùng chung, phân loại theo kind (docs/07 nguyên tắc chung)
enum CatalogKind {
  EXPENSE_CATEGORY // loại chi: cầu đường, bốc xếp, chành, bồi dưỡng, vật tư, thuê xe ngoài...
  INCOME_CATEGORY // loại thu khác
  ADDON_SERVICE // dịch vụ cộng thêm thu khách
  PAUSE_REASON // lý do tạm dừng chuyến: giờ cấm tải, nghỉ đêm, chờ phà...
  DEDUCTION_REASON // lý do giảm trừ lương
  CARGO_TYPE // loại hàng
}

enum PaidBy {
  COMPANY
  DRIVER // tài xế chi trước, thường được hoàn (reimbursable)
}

enum ExpensePaymentStatus {
  UNPAID
  PAID
}

// docs/04 mục 3.2 — DRIVER_COD_REMIT là thu hồi phải thu, KHÔNG phải doanh thu
enum PaymentInKind {
  CUSTOMER_PAYMENT
  DRIVER_COD_REMIT
  OTHER
}

enum PayrollStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED // chỉ ADMIN duyệt
  PAID
}

enum PayrollItemType {
  BONUS // thưởng theo order (ref trip)
  ADVANCE // ứng lương (ref expense có isDriverAdvance)
  DEDUCTION // giảm trừ + lý do
}

enum HistoryEntity {
  ORDER
  TRIP
  STOP
}

// ===== Tenant & con người =====

model Merchant {
  id        String   @id @default(cuid())
  name      String // tên nhà xe
  taxCode   String?
  address   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Settings (docs/05 mục 2, docs/04 mục 2)
  scheduleWarnHours  Float @default(2) // ngưỡng cảnh báo "gần trùng lịch" (giờ)
  payrollCycleConfig Json? // cấu hình kỳ lương theo merchant

  users           User[]
  drivers         Driver[]
  vehicles        Vehicle[]
  customers       Customer[]
  suppliers       Supplier[]
  catalogItems    CatalogItem[]
  orders          Order[]
  trips           Trip[]
  expenses        Expense[]
  paymentsIn      PaymentIn[]
  payrolls        Payroll[]
  statusHistories StatusHistory[]
  attachments     Attachment[]
}

model User {
  id           String   @id @default(cuid())
  merchantId   String
  merchant     Merchant @relation(fields: [merchantId], references: [id])
  email        String   @unique // đăng nhập toàn nền tảng
  passwordHash String
  fullName     String
  phone        String?
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdOrders     Order[]         @relation("OrderCreatedBy")
  createdExpenses   Expense[]       @relation("ExpenseCreatedBy")
  createdPayments   PaymentIn[]     @relation("PaymentInCreatedBy")
  createdPayrolls   Payroll[]       @relation("PayrollCreatedBy")
  approvedPayrolls  Payroll[]       @relation("PayrollApprovedBy")
  statusChanges     StatusHistory[]
  uploads           Attachment[]
  salaryChangesMade DriverSalaryHistory[]

  @@index([merchantId])
}

model Driver {
  id           String   @id @default(cuid())
  merchantId   String
  merchant     Merchant @relation(fields: [merchantId], references: [id])
  fullName     String
  phone        String   @unique // đăng nhập app bằng số điện thoại
  passwordHash String
  licenseNo    String? // số GPLX
  baseSalary   BigInt   @default(0) // lương cố định hiện hành (docs/04 mục 1)
  isActive     Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  salaryHistory  DriverSalaryHistory[]
  trips          Trip[]
  expenses       Expense[] // chi phí tài xế liên quan (hoàn ứng, ứng lương...)
  codRemits      PaymentIn[]
  payrollLines   PayrollLine[]
  statusChanges  StatusHistory[]
  uploads        Attachment[]

  @@index([merchantId])
}

// Lưu lịch sử đổi lương cố định để kỳ lương cũ tính đúng (docs/04)
model DriverSalaryHistory {
  id            String   @id @default(cuid())
  driverId      String
  driver        Driver   @relation(fields: [driverId], references: [id])
  baseSalary    BigInt
  effectiveFrom DateTime
  changedById   String?
  changedBy     User?    @relation(fields: [changedById], references: [id])
  createdAt     DateTime @default(now())

  @@index([driverId, effectiveFrom])
}

model Vehicle {
  id             String   @id @default(cuid())
  merchantId     String
  merchant       Merchant @relation(fields: [merchantId], references: [id])
  plateNumber    String // biển số
  type           String? // loại xe: tải thùng, mui bạt, đầu kéo...
  loadCapacityKg Int?
  isActive       Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  trips    Trip[]
  expenses Expense[] // vật tư, sửa chữa gắn theo xe

  @@unique([merchantId, plateNumber])
  @@index([merchantId])
}

model Customer {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  name       String
  phone      String?
  email      String?
  address    String?
  taxCode    String?
  isActive   Boolean  @default(true)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders     Order[]
  paymentsIn PaymentIn[]

  @@index([merchantId])
}

model Supplier {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  name       String
  category   String? // vận tải thuê ngoài / vật tư / khác — mô tả tự do
  phone      String?
  address    String?
  taxCode    String?
  isActive   Boolean  @default(true)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  expenses Expense[] // công nợ NCC = tổng expense UNPAID

  @@index([merchantId])
}

// Danh mục merchant tự định nghĩa, seed mặc định khi tạo merchant
model CatalogItem {
  id         String      @id @default(cuid())
  merchantId String
  merchant   Merchant    @relation(fields: [merchantId], references: [id])
  kind       CatalogKind
  name       String
  isActive   Boolean     @default(true)
  sortOrder  Int         @default(0)
  createdAt  DateTime    @default(now())

  expenses         Expense[]
  orderAddons      OrderAddon[]
  cargoLines       CargoLine[]
  pausedTrips      Trip[]            @relation("TripPauseReason")
  payrollLineItems PayrollLineItem[]

  @@unique([merchantId, kind, name])
  @@index([merchantId, kind])
}

// ===== Đơn hàng & vận hành =====

model Order {
  id          String      @id @default(cuid())
  merchantId  String
  merchant    Merchant    @relation(fields: [merchantId], references: [id])
  code        String // mã đơn, sinh theo merchant (BTA-2026-0001...)
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  status      OrderStatus @default(DRAFT)
  price       BigInt      @default(0) // giá cước nhập tay, CHUNG cả đơn (docs/02 mục 2)
  dueDate     DateTime? // hạn thanh toán — operation nhập tay (docs/03 mục 1.1)
  notes       String?
  createdById String
  createdBy   User        @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  stops       OrderStop[]
  cargoLines  CargoLine[]
  addons      OrderAddon[]
  trips       Trip[]
  expenses    Expense[] // thuê xe ngoài luôn gắn order (docs/03 mục 2)
  allocations PaymentAllocation[]

  // Tổng phải thu của đơn = price + sum(addons.amount) — tính ở tầng service, không lưu.

  @@unique([merchantId, code])
  @@index([merchantId, status])
  @@index([merchantId, customerId])
  @@index([merchantId, dueDate])
}

model OrderStop {
  id           String     @id @default(cuid())
  orderId      String
  order        Order      @relation(fields: [orderId], references: [id])
  type         StopType
  sequence     Int // thứ tự trong đơn
  address      String
  contactName  String?
  contactPhone String?
  status       StopStatus @default(PENDING)
  // Thu hộ COD theo điểm (docs/02; docs/05: tài xế input số thực thu trên app lúc nhận tiền)
  codExpected  BigInt     @default(0)
  codCollected BigInt? // null = chưa thu; tài xế nhập
  codCollectedAt DateTime?
  arrivedAt    DateTime?
  completedAt  DateTime?
  notes        String?

  tripAssigns        TripStopAssign[]
  cargoPickupLines   CargoLine[]      @relation("CargoPickupStop")
  cargoDropoffLines  CargoLine[]      @relation("CargoDropoffStop")

  @@index([orderId, sequence])
}

// Hàng hóa: mục đích chính là ghi chú, không validate chặt (docs/02 mục 6)
model CargoLine {
  id            String       @id @default(cuid())
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id])
  name          String // field bắt buộc duy nhất
  cargoTypeId   String?
  cargoType     CatalogItem? @relation(fields: [cargoTypeId], references: [id])
  weightKg      Float?
  volumeM3      Float?
  quantity      Float?
  unit          String? // kiện, pallet, thùng, bao, cây, cuộn...
  properties    String[] // dễ vỡ, hàng lạnh, quá khổ, nguy hiểm...
  declaredValue BigInt?
  notes         String?
  pickupStopId  String?
  pickupStop    OrderStop?   @relation("CargoPickupStop", fields: [pickupStopId], references: [id])
  dropoffStopId String?
  dropoffStop   OrderStop?   @relation("CargoDropoffStop", fields: [dropoffStopId], references: [id])

  @@index([orderId])
}

// Dịch vụ cộng thêm — tiền THU của khách, cộng vào tổng đơn (docs/02 mục 7.1)
model OrderAddon {
  id            String       @id @default(cuid())
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id])
  catalogItemId String?
  catalogItem   CatalogItem? @relation(fields: [catalogItemId], references: [id])
  name          String // snapshot tên tại thời điểm thêm
  amount        BigInt
  notes         String?

  @@index([orderId])
}

model Trip {
  id             String       @id @default(cuid())
  merchantId     String
  merchant       Merchant     @relation(fields: [merchantId], references: [id])
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id])
  vehicleId      String
  vehicle        Vehicle      @relation(fields: [vehicleId], references: [id])
  driverId       String
  driver         Driver       @relation(fields: [driverId], references: [id])
  status         TripStatus   @default(SCHEDULED)
  plannedStartAt DateTime? // dùng cho cảnh báo trùng/gần trùng lịch (docs/05 mục 2)
  plannedEndAt   DateTime?
  actualStartAt  DateTime?
  actualEndAt    DateTime?
  // PAUSED kèm lý do từ danh mục (docs/02 mục 4.2)
  pauseReasonId  String?
  pauseReason    CatalogItem? @relation("TripPauseReason", fields: [pauseReasonId], references: [id])
  pauseNote      String?
  driverBonus    BigInt       @default(0) // thưởng theo order, operation điền tay (docs/04 mục 1)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  stopAssigns      TripStopAssign[]
  locations        TripLocation[]
  expenses         Expense[]
  payrollLineItems PayrollLineItem[]

  @@index([merchantId, status])
  @@index([merchantId, vehicleId, plannedStartAt])
  @@index([merchantId, driverId, plannedStartAt])
  @@index([orderId])
}

// Trip nào phụ trách stop nào — chỉ thật sự cần khi đơn nhiều xe (docs/02 mục 3)
model TripStopAssign {
  id          String    @id @default(cuid())
  tripId      String
  trip        Trip      @relation(fields: [tripId], references: [id])
  orderStopId String
  orderStop   OrderStop @relation(fields: [orderStopId], references: [id])

  @@unique([tripId, orderStopId])
}

// GPS: app gửi batch khi chuyến đang chạy (docs/05; docs/08). Bảng ghi nhiều — dọn/partition sau.
model TripLocation {
  id         BigInt   @id @default(autoincrement())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id])
  lat        Float
  lng        Float
  accuracyM  Float?
  recordedAt DateTime

  @@index([tripId, recordedAt])
}

// Lịch sử trạng thái dùng chung — operation đổi tự do nhưng lưu vết (docs/02 mục 4)
model StatusHistory {
  id         String        @id @default(cuid())
  merchantId String
  merchant   Merchant      @relation(fields: [merchantId], references: [id])
  entityType HistoryEntity
  entityId   String
  fromStatus String?
  toStatus   String
  reason     String?
  byUserId   String?
  byUser     User?         @relation(fields: [byUserId], references: [id])
  byDriverId String?
  byDriver   Driver?       @relation(fields: [byDriverId], references: [id])
  createdAt  DateTime      @default(now())

  @@index([merchantId, entityType, entityId])
}

// File đính kèm: ảnh POD theo stop, chứng từ hàng, hóa đơn chi phí...
model Attachment {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  entityType String // "ORDER_STOP" | "ORDER" | "EXPENSE" | ...
  entityId   String
  fileKey    String // key trên S3/MinIO
  fileName   String?
  mimeType   String?
  sizeBytes  Int?
  byUserId   String?
  byUser     User?    @relation(fields: [byUserId], references: [id])
  byDriverId String?
  byDriver   Driver?  @relation(fields: [byDriverId], references: [id])
  createdAt  DateTime @default(now())

  @@index([merchantId, entityType, entityId])
}

// ===== Tiền =====

// Một sổ chi cho tất cả: chi phí chuyến, thuê xe ngoài, vật tư, hoàn ứng tài xế,
// ứng lương, chi khác (docs/03 mục 2)
model Expense {
  id            String               @id @default(cuid())
  merchantId    String
  merchant      Merchant             @relation(fields: [merchantId], references: [id])
  categoryId    String
  category      CatalogItem          @relation(fields: [categoryId], references: [id])
  amount        BigInt
  expenseDate   DateTime
  paymentStatus ExpensePaymentStatus @default(UNPAID)
  paidAt        DateTime?
  paidBy        PaidBy               @default(COMPANY) // ai chi trước (docs/02 mục 7.2)
  reimbursable  Boolean              @default(false) // tài xế chi trước, cần hoàn
  isDriverAdvance Boolean            @default(false) // ứng lương — trừ vào bảng lương (docs/04)
  // Gắn ngữ cảnh (tất cả tùy chọn; thuê xe ngoài LUÔN gắn orderId — enforce ở service)
  supplierId    String?
  supplier      Supplier?            @relation(fields: [supplierId], references: [id])
  orderId       String?
  order         Order?               @relation(fields: [orderId], references: [id])
  tripId        String?
  trip          Trip?                @relation(fields: [tripId], references: [id])
  vehicleId     String?
  vehicle       Vehicle?             @relation(fields: [vehicleId], references: [id])
  driverId      String?
  driver        Driver?              @relation(fields: [driverId], references: [id])
  notes         String?
  createdById   String
  createdBy     User                 @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  payrollLineItems PayrollLineItem[]

  @@index([merchantId, expenseDate])
  @@index([merchantId, supplierId, paymentStatus])
  @@index([merchantId, driverId])
  @@index([orderId])
  @@index([tripId])
  @@index([vehicleId])
}

// Phiếu thu. Kind DRIVER_COD_REMIT = tài xế nộp COD về — thu hồi PHẢI THU,
// tuyệt đối không tính vào doanh thu (docs/04 mục 3.2)
model PaymentIn {
  id           String        @id @default(cuid())
  merchantId   String
  merchant     Merchant      @relation(fields: [merchantId], references: [id])
  kind         PaymentInKind
  customerId   String?
  customer     Customer?     @relation(fields: [customerId], references: [id])
  driverId     String?
  driver       Driver?       @relation(fields: [driverId], references: [id])
  amount       BigInt
  receivedDate DateTime
  method       String? // tiền mặt, chuyển khoản...
  notes        String?
  createdById  String
  createdBy    User          @relation("PaymentInCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime      @default(now())

  allocations PaymentAllocation[]

  @@index([merchantId, receivedDate])
  @@index([merchantId, customerId])
  @@index([merchantId, driverId])
}

// Operation phân bổ thủ công tiền thu vào từng đơn (docs/03 mục 1.1)
// Số dư khách = tổng PaymentIn (CUSTOMER_PAYMENT) − tổng allocation của các phiếu đó
model PaymentAllocation {
  id          String    @id @default(cuid())
  paymentInId String
  paymentIn   PaymentIn @relation(fields: [paymentInId], references: [id])
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id])
  amount      BigInt
  createdAt   DateTime  @default(now())

  @@index([orderId])
  @@index([paymentInId])
}

// ===== Lương =====

model Payroll {
  id           String        @id @default(cuid())
  merchantId   String
  merchant     Merchant      @relation(fields: [merchantId], references: [id])
  periodStart  DateTime
  periodEnd    DateTime
  status       PayrollStatus @default(DRAFT)
  createdById  String
  createdBy    User          @relation("PayrollCreatedBy", fields: [createdById], references: [id])
  approvedById String? // chỉ ADMIN (docs/04 mục 2)
  approvedBy   User?         @relation("PayrollApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  lines PayrollLine[]

  @@index([merchantId, periodStart])
}

model PayrollLine {
  id             String  @id @default(cuid())
  payrollId      String
  payroll        Payroll @relation(fields: [payrollId], references: [id])
  driverId       String
  driver         Driver  @relation(fields: [driverId], references: [id])
  baseSalary     BigInt // snapshot lương cố định tại kỳ
  totalBonus     BigInt  @default(0)
  totalAdvance   BigInt  @default(0)
  totalDeduction BigInt  @default(0)
  netAmount      BigInt  @default(0) // base + bonus − advance − deduction

  items PayrollLineItem[]

  @@unique([payrollId, driverId])
}

model PayrollLineItem {
  id            String          @id @default(cuid())
  payrollLineId String
  payrollLine   PayrollLine     @relation(fields: [payrollLineId], references: [id])
  type          PayrollItemType
  amount        BigInt
  // BONUS -> tripId; ADVANCE -> expenseId; DEDUCTION -> reasonId + note
  tripId        String?
  trip          Trip?           @relation(fields: [tripId], references: [id])
  expenseId     String?
  expense       Expense?        @relation(fields: [expenseId], references: [id])
  reasonId      String?
  reason        CatalogItem?    @relation(fields: [reasonId], references: [id])
  note          String?

  @@index([payrollLineId])
}
