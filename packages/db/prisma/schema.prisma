  RECONCILED
}

enum DebtStatementStatus {
  DRAFT
  FINALIZED
  SENT
  CANCELLED
}

enum DebtStatementScope {
  UNPAID_ONLY
  ALL_IN_PERIOD
}

enum PayrollStatus {
  DRAFT
  SUBMITTED
  RETURNED
  APPROVED
  PAID
  CANCELLED
}

enum PayrollItemType {
  BASE
  BONUS
  ADVANCE
  DEDUCTION
  ADJUSTMENT
}

enum PayrollPeriodType {
  MONTHLY
  CUSTOM
}

enum BookingStatus {
  SUBMITTED
  ACCEPTED
  CONVERTED
  REJECTED
  CANCELLED
}

enum ActorType {
  USER
  DRIVER
  CUSTOMER
  SYSTEM
}

enum RecipientType {
  USER
  DRIVER
  CUSTOMER
}

enum EntityType {
  MERCHANT
  MERCHANT_USER
  CUSTOMER
  CUSTOMER_LOCATION
  DRIVER
  VEHICLE
  SUPPLIER
  CATALOG_ITEM
