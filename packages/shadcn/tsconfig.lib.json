{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noUnusedLocals": false,
    "noImplicitReturns": false,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "src/components/animate-ui/demo/**",
    "src/components/animate-ui/components/headless/tabs.tsx",
    "src/components/animate-ui/components/base/tooltip.tsx",
    "src/components/animate-ui/primitives/base/progress.tsx",
    "src/components/animate-ui/components/base/progress.tsx"
  ],
  "references": []
}
